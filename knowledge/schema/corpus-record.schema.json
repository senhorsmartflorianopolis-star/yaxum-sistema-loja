{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yaxum.com.br/schemas/corpus-record.schema.json",
  "title": "Registro de fonte do corpus YAXUM",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "text",
    "source_name",
    "source_url",
    "license",
    "language",
    "topics"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$" },
    "title": { "type": "string", "minLength": 3 },
    "text": { "type": "string", "minLength": 40 },
    "source_name": { "type": "string", "minLength": 2 },
    "source_url": { "type": "string", "format": "uri", "pattern": "^https://" },
    "author": { "type": "string" },
    "license": {
      "type": "string",
      "enum": ["CC0-1.0", "CC-BY-4.0", "CC-BY-SA-4.0", "PDM-1.0"]
    },
    "language": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
    "topics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
    },
    "batch_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "knowledge_kind": {
      "type": "string",
      "enum": ["anatomia", "neurociencia", "ciencia-cognitiva", "modelo-psicanalitico", "historia-das-ideias"]
    },
    "evidence_level": {
      "type": "string",
      "enum": ["referencia-oficial", "revisao-sistematica", "revisao-cientifica", "pesquisa-primaria", "modelo-clinico-historico"]
    },
    "model_status": {
      "type": "string",
      "enum": ["anatomico", "funcional", "teorico", "clinico-historico"]
    },
    "epistemic_note": { "type": "string" },
    "source_rights_note": { "type": "string" },
    "published_at": { "type": "string", "format": "date" },
    "retrieved_at": { "type": "string", "format": "date" },
    "notes": { "type": "string" }
  }
}
