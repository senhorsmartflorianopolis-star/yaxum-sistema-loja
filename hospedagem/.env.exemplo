# YAXUM Hospedagem · copie este arquivo para ".env" e preencha.

# teste = não envia nada ao hóspede; anota na conversa o que responderia.
# automatico = responde de verdade. Comece SEMPRE em teste.
MODO=teste

# Token da Hostex: painel → Settings → OpenAPI Settings → "+ Add new", tipo "writable".
HOSTEX_TOKEN=

# Segredo do webhook: sai do comando "npm run webhook -- https://SEU-ENDERECO/webhook/hostex".
HOSTEX_WEBHOOK_SECRET=

# Dados privados das casas (senha do Wi-Fi, endereço, código do cofre), num JSON de uma linha.
# Alternativa: arquivo cerebro/privado.json (o git ignora). Modelo em cerebro/privado.exemplo.json.
# Ex.: CEREBRO_PRIVADO={"alvenaria":{"wifi_nome":"...","wifi_senha":"...","endereco":"..."}}
CEREBRO_PRIVADO=

# Senha para abrir /registro e usar /testar (invente uma longa).
TOKEN_ADMIN=

# Porta do servidor (Render, Railway etc. preenchem sozinhos com PORT).
PORTA=3000

# Canais que o YAXUM atende: airbnb (padrão), ou lista: airbnb,booking.com — ou "todos".
CANAIS=airbnb

# Aviso no celular quando precisar da Yasmim (opcional, grátis):
# instale o app "ntfy", assine um tópico com nome difícil de adivinhar e coloque o mesmo nome aqui.
AVISO_NTFY_TOPICO=

# --- ajustes finos (pode deixar como está) ---
# Segundos esperando o hóspede terminar de escrever antes de responder.
AGUARDAR_SEGUNDOS=20
# Se a Yasmim respondeu nesta conversa nos últimos X minutos, o YAXUM fica quieto.
PAUSA_SE_HUMANO_MINUTOS=60
# Mensagem mais velha que isso não recebe resposta automática.
IDADE_MAXIMA_MINUTOS=180
# Máximo de respostas automáticas por conversa por dia.
LIMITE_RESPOSTAS_DIA=15
# De quanto em quanto tempo conferir se algum aviso da Hostex se perdeu (0 desliga).
VARREDURA_MINUTOS=10
# Escrever na nota privada da conversa o que o YAXUM fez (sim/nao).
ANOTAR=sim
